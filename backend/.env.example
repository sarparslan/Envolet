# Database connection string (SQLAlchemy URL)
DATABASE_URL=sqlite:///./envolet.db

# JWT signing secret -- change this in any non-local environment
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenRouter (AI suggestions). Leave empty to disable /ai/suggestion (returns 503).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*
